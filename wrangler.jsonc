{
  "name": "ops-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "BLOB_BUCKET",
      "bucket_name": "ops-app-data"
    }
  ],
  "vars": {
    // CF Tunnel URL for stats-server — reachable from CF Workers edge
    // localhost:9003 does not exist at the edge; use the public tunnel URL
    "PM2_STATS_URL": "https://stats.frxncois.com"
    // STATS_SECRET must be set via `wrangler secret put STATS_SECRET`
  }
}
